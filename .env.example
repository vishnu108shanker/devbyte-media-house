# DevByte Media House — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# MongoDB Atlas — read-only user (used by Vercel/the website only)
MONGODB_URI=mongodb+srv://<read-only-user>:<password>@cluster0.mdebgdu.mongodb.net

# Admin auth (Phase 2) — bcrypt hash of the admin password
ADMIN_PASSWORD_HASH=

# Session signing secret (Phase 2) — random 32+ char string
SESSION_SECRET=
